{
  "name": "codex-capacity-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "codex-capacity-proxy": "dist/local.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test",
    "local": "node src/local.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
